; Engine configuration file.
; Edit through Godot where practical to preserve valid setting names.

config_version=5

[application]

config/name="Paint Mountain"
config/description="A gravity-driven 3D paintball puzzle game."
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.72, 0.82, 0.9, 1)
